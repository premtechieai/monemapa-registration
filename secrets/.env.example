# -----------------------------------------------------------------------------
# Secrets template. Copy to `secrets/.env` and fill in real values.
#   cp secrets/.env.example secrets/.env
# `secrets/.env` is git-ignored. In production, set these as real environment
# variables instead (values already in the environment take precedence).
# -----------------------------------------------------------------------------

# --- Database: Supabase project > Project Settings > API ---------------------
SUPABASE_URL=https://your-project-ref.supabase.co

# "service_role" / secret key. SERVER ONLY: bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Email: SMTP login -------------------------------------------------------
# Host, port and sender address are in config/default.json (email.smtp / email.from).
# Resend:  SMTP_USER=resend   SMTP_PASSWORD=<your Resend API key, re_...>
# Gmail:   SMTP_USER=<you@gmail.com>   SMTP_PASSWORD=<16-char app password>
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password

# --- App ---------------------------------------------------------------------
# Random string (32+ chars): signs cookies and keys one-time-code hashes.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=replace-with-a-long-random-string
